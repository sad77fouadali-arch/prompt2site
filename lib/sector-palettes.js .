/**
 * Détecte le secteur depuis la description client
 * @param {string} description - Texte libre du client
 * @returns {Object} Palette correspondante
 */
function detectSectorPalette(description) {
  const text = description.toLowerCase();
  
  const keywords = {
    luxe: ['luxe', 'premium', 'haut de gamme', 'jewelry', 'bijou', 'montre', 'exclusive'],
    saas: ['saas', 'logiciel', 'app', 'application', 'tech', 'startup', 'plateforme', 'dashboard'],
    restauration: ['restaurant', 'café', 'cafe', 'menu', 'food', 'cuisine', 'pizza', 'grill', 'tiramisu'],
    mode: ['mode', 'fashion', 'vêtement', 'textile', 'boutique', 'habit', 'dress', 'style'],
    beaute: ['beauté', 'beaute', 'salon', 'coiffure', 'spa', 'cosmetic', 'maquillage', 'nails']
  };
  
  for (const [sector, words] of Object.entries(keywords)) {
    if (words.some(word => text.includes(word))) {
      return SECTOR_PALETTES[sector];
    }
  }
  
  // Défaut : SaaS clair (le plus universel pour PME Djibouti)
  return SECTOR_PALETTES.saas;
}

module.exports = { SECTOR_PALETTES, detectSectorPalette };
